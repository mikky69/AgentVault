PORT=3001
DASHBOARD_ORIGIN=http://localhost:5173
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
ADMIN_API_KEY=

# Mainnet deployment and the private key of the deployed treasury owner.
EVM_RPC_URL=
CHAIN_ID=8453
AGENT_TREASURY_ADDRESS=
OWNER_PRIVATE_KEY=
CONTRACT_DEPLOYMENT_BLOCK=
EVENT_CONFIRMATIONS=3
EVENT_POLL_INTERVAL_MS=12000

# Required only for the dashboard's demo `spend` command. This wallet must be
# funded and have a policy and allowed counterparty configured on the treasury.
DEMO_AGENT_PRIVATE_KEY=
ENABLE_DEMO_SPEND=false

# Required for actual same-asset settlement after a SpendExecuted event.
SETTLEMENT_TOKEN_ADDRESS=
SETTLEMENT_CHAIN_ID=8453
SETTLEMENT_RPC_URL=
RELAYER_PRIVATE_KEY=
